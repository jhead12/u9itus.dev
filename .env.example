APP_NAME=U9itus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Platform Configuration
# Options: 'wix', 'standalone', or 'dual' (both platforms enabled)
PLATFORM_MODE=dual
FRONTEND_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Set to 'reverb' in production; 'log' for CI / local without a running Reverb server
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Service role for wait-for-db.sh (web|queue|scheduler|reverb)
PROCESS_ROLE=web
# Web service safe default: only enable once dedicated reverb service is healthy
ENABLE_REVERB=false

# Performance diagnostics (logs only when thresholds are exceeded)
SLOW_REQUEST_LOG_THRESHOLD_MS=1200
SLOW_QUERY_LOG_THRESHOLD_MS=300

# ── Laravel Reverb WebSocket server (Phase 11) ─────────────────────────────
REVERB_APP_ID=u9itus-app
REVERB_APP_KEY=your-reverb-app-key-change-me
REVERB_APP_SECRET=your-reverb-app-secret-change-me
REVERB_HOST=localhost
REVERB_PORT=6001
REVERB_SERVER_PORT=6001
REVERB_SCHEME=http
REVERB_TIMEOUT=5

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail driver options: log (dev), mailgun, smtp, ses, postmark, resend
# Use MAIL_MAILER=log for local development — emails are written to storage/logs/laravel.log
# Use MAIL_MAILER=mailgun for staging/production with Mailgun credentials below.
#
# ⚠ MAILGUN SANDBOX LIMITATION:
#   Sandbox domains (sandbox*.mailgun.org) can only send to AUTHORIZED recipients.
#   Add recipients at: https://app.mailgun.com/mg/sending/domains/<your-sandbox>/authorized-recipients
#   For real email delivery, add a custom domain in Mailgun and update MAILGUN_DOMAIN + MAIL_FROM_ADDRESS.
#
# Run `php artisan email:diagnose` to check your mail configuration.
# Run `php artisan email:diagnose --send --to=you@example.com` to send a test email.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun HTTP API (used when MAIL_MAILER=mailgun)
# MAILGUN_DOMAIN=sandbox123.mailgun.org  ← replace with your real sending domain
# MAILGUN_SECRET=your-mailgun-api-key
# MAILGUN_ENDPOINT=api.mailgun.net
#
# Mailgun Mailing List — registration waitlist capture
# Create a mailing list in the Mailgun dashboard (Sending → Mailing Lists), then set its address here.
# Subscribers from the registration-closed page will be upserted into this list automatically.
# MAILGUN_MAILING_LIST_ADDRESS=waitlist@mg.yourdomain.com
#
# ⚠ QUEUE NOTE: If emails are queued (QUEUE_CONNECTION != sync), run:
#   php artisan queue:work   — otherwise queued mails will never be dispatched.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe Payment Configuration (Test Mode)
STRIPE_KEY=pk_test_your_stripe_key
STRIPE_SECRET=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Early-bank.com — sibling Railway service (marketing/referral storefront).
# EARLYBANK_API_TOKEN: shared bearer token for /api/v1/earlybank/* endpoints.
#   Must match U9ITUS_API_TOKEN on the earlybank service.
# EARLYBANK_WEBHOOK_URL: where to POST signed voter.earned / voter.referred events.
#   Use the Railway private URL in production (e.g. http://earlybank.railway.internal).
# EARLYBANK_WEBHOOK_SECRET: HMAC-SHA256 key for X-EarlyBank-Signature header.
# EARLYBANK_ENABLED: master switch for outbound webhook dispatch.
EARLYBANK_API_TOKEN=
EARLYBANK_WEBHOOK_URL=
EARLYBANK_WEBHOOK_SECRET=
EARLYBANK_ENABLED=false

# PayPal Payouts Configuration (Batch voter payouts)
# Create credentials at https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true
PAYPAL_WEBHOOK_ID=
PAYPAL_STRICT_WEBHOOK_VERIFICATION=

# Cash App outbound payout configuration
CASHAPP_API_KEY=
CASHAPP_MERCHANT_ID=
CASHAPP_BASE_URL=https://sandbox.api.cash.app
CASHAPP_PAYMENTS_ENDPOINT=/network/v1/payments
CASHAPP_DEFAULT_GRANT_ID=
CASHAPP_REGION=US
CASHAPP_SIGNATURE=
CASHAPP_USER_AGENT=u9itus-cashapp/1.0
CASHAPP_TIMEOUT=30

# Id.me verification (OAuth 2.0)
# Create app credentials at https://developer.id.me
IDME_CLIENT_ID=
IDME_CLIENT_SECRET=
IDME_REDIRECT_URI="${APP_URL}/verification/idme/callback"
IDME_AUTH_URL=https://api.id.me/oauth/authorize
IDME_TOKEN_URL=https://api.id.me/oauth/token
IDME_ATTRIBUTES_URL=https://api.id.me/api/public/v3/attributes.json
IDME_SCOPES=identity,email

# U9itus Configuration – Political Loyalty Ads
HEAD_ENTERPRISES_FEE_PERCENT=15.0
ASSIGNMENT_EXPIRY_HOURS=24
MIN_WATCH_TIME_PERCENT=100
MIN_PAYOUT_AMOUNT=5.00
DEFAULT_PAYMENT_PER_VIEW=0.25
MAX_VIDEO_DURATION=300
MIN_VIDEO_DURATION=30
ALLOW_LIVE_FEED=true

# Per-View Pricing
REVENUE_PER_VIEW=1.00
VIEWER_PAYOUT_PER_VIEW=0.25
REFERRAL_COMMISSION_PERCENT=10
PROCUREMENT_COMMISSION_PERCENT=10

# Fraud Prevention
MAX_VIEWS_PER_VOTER_PER_DAY=50
DEVICE_FINGERPRINT_REQUIRED=true
PAYOUT_HOLD_HOURS=48
SUSPICIOUS_ACTIVITY_THRESHOLD=10

# Batch Payouts
PAYOUT_BATCH_FREQUENCY=weekly
PAYOUT_THRESHOLD_AMOUNT=5.00

# Wix App Configuration
WIX_APP_ID=your-wix-app-id
WIX_APP_SECRET=your-wix-app-secret
WIX_WEBHOOK_SECRET=your-wix-webhook-secret
WIX_APP_URL="${APP_URL}"
WIX_REDIRECT_URL=/wix/oauth/callback
WIX_SIGNUP_URL=/wix/signup

VITE_APP_NAME="${APP_NAME}"

# ── Reverb client-side (expose to Vite build) ──────────────────────────────
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Phase 16: Public Data Integration APIs for Candidates & Officials ──────
#
# These APIs provide election candidate data, voting records, and official information.
# All are optional — the system gracefully degrades if not configured.
#
# Ballotpedia: Free tier (1000 req/day), perfect for all election types
# Register: https://ballotpedia.org/api/request
BALLOTPEDIA_API_KEY=

# Vote Smart (Project Vote Smart): Free API, comprehensive voting records
# Register: https://justfacts.votesmart.org/api/register
VOTESMART_API_KEY=

# Federal Election Commission: Free API, federal campaign finance data
# Register: https://api.open.fec.gov/developers
FEC_API_KEY=

# OpenSecrets: Free API, campaign finance and lobbying data
# Register: https://www.opensecrets.org/api-documentation
OPENSECRETS_API_KEY=

# Google Civic Information API: Free (10k queries/day), perfect for local officials by address
# 1. Create API key: https://console.cloud.google.com/apis/credentials
# 2. Enable "Civic Information API"
# 3. Add key below
GOOGLE_CIVIC_API_KEY=

# US Census Bureau API key (optional — increases rate limits)
# Register free at: https://api.census.gov/data/key_signup.html
CENSUS_DATA_API=
# Anthropic Claude — AI enrichment Tier 3 fallback for statewide officeholder data
# Used by: php artisan politicians:enrich-statewide (falls back to Claude only when
# Ballotpedia and Wikipedia both fail to extract a current officeholder name).
# Get a key: https://console.anthropic.com/
# Add to GitHub Actions secrets as ANTHROPIC_API_KEY and to Railway env vars.
ANTHROPIC_API_KEY=
ANTHROPIC_ENRICH_MODEL=claude-haiku-4-5