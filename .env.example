APP_NAME=U9itus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Platform Configuration
# Options: 'wix', 'standalone', or 'dual' (both platforms enabled)
PLATFORM_MODE=dual
FRONTEND_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail driver options: log (dev), mailgun, smtp, ses, postmark, resend
# Use MAIL_MAILER=log for local development — emails are written to storage/logs/laravel.log
# Use MAIL_MAILER=mailgun for staging/production with Mailgun credentials below.
#
# ⚠ MAILGUN SANDBOX LIMITATION:
#   Sandbox domains (sandbox*.mailgun.org) can only send to AUTHORIZED recipients.
#   Add recipients at: https://app.mailgun.com/mg/sending/domains/<your-sandbox>/authorized-recipients
#   For real email delivery, add a custom domain in Mailgun and update MAILGUN_DOMAIN + MAIL_FROM_ADDRESS.
#
# Run `php artisan email:diagnose` to check your mail configuration.
# Run `php artisan email:diagnose --send --to=you@example.com` to send a test email.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun HTTP API (used when MAIL_MAILER=mailgun)
# MAILGUN_DOMAIN=sandbox123.mailgun.org  ← replace with your real sending domain
# MAILGUN_SECRET=your-mailgun-api-key
# MAILGUN_ENDPOINT=api.mailgun.net
#
# ⚠ QUEUE NOTE: If emails are queued (QUEUE_CONNECTION != sync), run:
#   php artisan queue:work   — otherwise queued mails will never be dispatched.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe Payment Configuration (Test Mode)
STRIPE_KEY=pk_test_your_stripe_key
STRIPE_SECRET=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# PayPal Payouts Configuration (Batch voter payouts)
# Create credentials at https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=AbGt0I4h6bzSMXYdgtiPM15caduYmHx8RNLAGaLz-q9fayJBq6LcPuuxW8J6x-NiTYkQ1aboZiBmrD8F
PAYPAL_CLIENT_SECRET=EBOSykVrgksZa8qwgB83W0DdT2bv3IC0VGHic-KbGfiGug1NmKF1fAETBXq16aIeaGnSxF7M1-EjyfU9
PAYPAL_SANDBOX=true

# U9itus Configuration – Political Loyalty Ads
HEAD_ENTERPRISES_FEE_PERCENT=15.0
ASSIGNMENT_EXPIRY_HOURS=24
MIN_WATCH_TIME_PERCENT=100
MIN_PAYOUT_AMOUNT=5.00
DEFAULT_PAYMENT_PER_VIEW=0.25
MAX_VIDEO_DURATION=300
MIN_VIDEO_DURATION=30
ALLOW_LIVE_FEED=true

# Per-View Pricing
REVENUE_PER_VIEW=0.60
VIEWER_PAYOUT_PER_VIEW=0.25
REFERRAL_COMMISSION_PERCENT=10
PROCUREMENT_COMMISSION_PERCENT=10

# Fraud Prevention
MAX_VIEWS_PER_VOTER_PER_DAY=50
DEVICE_FINGERPRINT_REQUIRED=true
PAYOUT_HOLD_HOURS=48
SUSPICIOUS_ACTIVITY_THRESHOLD=10

# Batch Payouts
PAYOUT_BATCH_FREQUENCY=weekly
PAYOUT_THRESHOLD_AMOUNT=10.00

# Wix App Configuration
WIX_APP_ID=your-wix-app-id
WIX_APP_SECRET=your-wix-app-secret
WIX_WEBHOOK_SECRET=your-wix-webhook-secret
WIX_APP_URL="${APP_URL}"
WIX_REDIRECT_URL=/wix/oauth/callback
WIX_SIGNUP_URL=/wix/signup

VITE_APP_NAME="${APP_NAME}"

