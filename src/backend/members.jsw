/**
 * Wix Members Integration Module
 * 
 * This module connects Wix Members/Contacts to U9itus voter accounts.
 * It handles member authentication and syncs member data with backend voter records.
 */

import { currentMember } from 'wix-members';
import { contacts } from 'wix-crm';
import { registerVoter } from './campaigns.jsw';
import wixSecretsBackend from 'wix-secrets-backend';

/**
 * Get current logged-in Wix member
 * @returns {Promise<object|null>} Member object or null if not logged in
 */
export async function getCurrentMember() {
    try {
        const member = await currentMember.getMember();
        return member;
    } catch (error) {
        console.warn('No member logged in:', error);
        return null;
    }
}

/**
 * Get or create voter account for current Wix member
 * This syncs Wix member data with backend voter records
 * @returns {Promise<object>} Voter data with UUID
 */
export async function getOrCreateVoterForMember() {
    try {
        const member = await getCurrentMember();
        
        if (!member) {
            throw new Error('No member logged in');
        }

        // Check if we already have a voter UUID for this member
        const storedUuid = await getStoredVoterUuid(member._id);
        
        if (storedUuid) {
            return { uuid: storedUuid, isNew: false };
        }

        // Get member contact info
        const contactInfo = await getContactInfo(member.contactId);
        
        // Create new voter in backend
        const voterData = {
            email: contactInfo.email || member.loginEmail,
            full_name: `${contactInfo.firstName || ''} ${contactInfo.lastName || ''}`.trim() || 'Wix Member',
            zip_code: contactInfo.postalCode || '00000',
            phone: contactInfo.phone || '',
            wix_member_id: member._id,
            wix_contact_id: member.contactId
        };

        const response = await registerVoter(voterData);
        
        // Store the voter UUID mapped to this Wix member
        await storeVoterUuid(member._id, response.voter.uuid);
        
        return { 
            uuid: response.voter.uuid, 
            isNew: true,
            referralCode: response.referral_code 
        };

    } catch (error) {
        console.error('Failed to get or create voter for member:', error);
        throw error;
    }
}

/**
 * Get contact information for a Wix contact
 * @param {string} contactId - Wix contact ID
 * @returns {Promise<object>} Contact information
 */
async function getContactInfo(contactId) {
    try {
        const contact = await contacts.getContact(contactId);
        return {
            email: contact.primaryInfo?.email,
            firstName: contact.info?.name?.first,
            lastName: contact.info?.name?.last,
            phone: contact.primaryInfo?.phone,
            postalCode: contact.primaryInfo?.address?.postalCode,
            city: contact.primaryInfo?.address?.city,
            state: contact.primaryInfo?.address?.subdivision
        };
    } catch (error) {
        console.warn('Failed to get contact info:', error);
        return {};
    }
}

/**
 * Store voter UUID for a Wix member
 * @param {string} memberId - Wix member ID
 * @param {string} voterUuid - Backend voter UUID
 */
async function storeVoterUuid(memberId, voterUuid) {
    try {
        // Store in Wix Secrets (secure storage)
        await wixSecretsBackend.setSecret(`voter_uuid_${memberId}`, voterUuid);
    } catch (error) {
        console.error('Failed to store voter UUID:', error);
    }
}

/**
 * Get stored voter UUID for a Wix member
 * @param {string} memberId - Wix member ID
 * @returns {Promise<string|null>} Voter UUID or null
 */
async function getStoredVoterUuid(memberId) {
    try {
        const uuid = await wixSecretsBackend.getSecret(`voter_uuid_${memberId}`);
        return uuid;
    } catch (error) {
        return null;
    }
}

/**
 * Check if current user is authenticated
 * @returns {Promise<boolean>}
 */
export async function isAuthenticated() {
    const member = await getCurrentMember();
    return member !== null;
}

/**
 * Get member profile for display
 * @returns {Promise<object>} Member profile
 */
export async function getMemberProfile() {
    try {
        const member = await getCurrentMember();
        
        if (!member) {
            return null;
        }

        const contact = await getContactInfo(member.contactId);
        
        return {
            id: member._id,
            email: contact.email || member.loginEmail,
            firstName: contact.firstName || '',
            lastName: contact.lastName || '',
            fullName: `${contact.firstName || ''} ${contact.lastName || ''}`.trim() || 'Member',
            phone: contact.phone || '',
            city: contact.city || '',
            state: contact.state || ''
        };
    } catch (error) {
        console.error('Failed to get member profile:', error);
        return null;
    }
}
