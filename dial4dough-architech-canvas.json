  "flows": [
    {
      "id": "flow-1",
      "name": "Politician Campaign Creation",
      "description": "Complete flow from campaign form submission to database storage and Stripe payment intent",
      "steps": [
        "Politician fills out campaign form (title, video URL, budget, target views)",
        "Wix Dashboard sends POST /api/campaigns",
        "Laravel validates request",
        "Campaign Management Service creates campaign (status: pending)",
        "Payment Processing Service creates Stripe payment intent",
        "Record saved to campaigns table",
        "Success response returned with campaign ID"
      ],
      "nodes": ["user-politician", "ui-politician-dashboard", "server-laravel-api", "service-campaign", "service-payment", "database-mysql", "external-stripe"]
    },
    {
      "id": "flow-2",
      "name": "Admin Campaign Approval",
      "description": "Admin reviews pending campaign and captures payment",
      "steps": [
        "Admin views pending campaigns",
        "Admin clicks Approve button",
        "Wix Dashboard sends POST /api/admin/campaigns/{id}/approve",
        "Laravel validates admin permissions",
        "Campaign Management Service updates status to active",
        "Payment Processing Service captures Stripe payment ($0.60 × target_views)",
        "Campaign now visible to voters",
        "Success response with updated campaign"
      ],
      "nodes": ["user-admin", "ui-admin-dashboard", "server-laravel-api", "service-campaign", "service-payment", "database-mysql", "external-stripe"]
    },
    {
      "id": "flow-3",
      "name": "Voter Watches Video & Earns",
      "description": "Complete viewing session with fraud checks and earnings credit",
      "steps": [
        "Voter opens voter dashboard",
        "Wix Dashboard fetches GET /api/voters/{id}/campaigns/available",
        "Voter clicks Watch Video",
        "Wix Dashboard sends POST /api/view-sessions with campaign_id",
        "View Tracking Service creates view session (status: in_progress)",
        "Fraud Detection Service checks voter activity limits",
        "Timer tracks watch time in frontend",
        "When 80% completed, send PUT /api/view-sessions/{id}/complete",
        "View Tracking Service validates completion",
        "Payment Processing Service credits $0.25 to voter earnings",
        "Campaign Management Service increments views_completed",
        "If voter has referrer, Referral System Service credits $0.025 commission",
        "Success response with updated earnings"
      ],
      "nodes": ["user-voter", "ui-voter-dashboard", "server-laravel-api", "service-view-tracking", "service-fraud", "service-payment", "service-referral", "service-campaign", "database-mysql"]
    },
    {
      "id": "flow-4",
      "name": "Referral Commission",
      "description": "Referral code generation and 10% commission tracking",
      "steps": [
        "Existing voter generates referral code via GET /api/voters/{id}/referral-code",
        "Referral System Service creates/retrieves unique code",
        "Voter shares code with friend",
        "New voter registers with referral code via POST /api/voters",
        "Referral System Service links voters (referred_by field)",
        "When new voter completes ANY view:",
        "Payment Processing Service calculates $0.25 for viewer",
        "Referral System Service calculates $0.025 (10%) for referrer",
        "Both amounts credited to respective pending_earnings",
        "Record created in referral_earnings table"
      ],
      "nodes": ["user-voter", "ui-voter-dashboard", "server-laravel-api", "service-referral", "service-payment", "database-mysql"]
    },
    {
      "id": "flow-5",
      "name": "Fraud Detection & Review",
      "description": "Automated fraud detection with admin review queue",
      "steps": [
        "During view completion, Fraud Detection Service runs checks",
        "Checks: views per day, views per hour, IP patterns, watch time patterns",
        "If threshold exceeded (50 views/day): flag voter, hold payments, notify admin",
        "Admin opens fraud review dashboard",
        "Admin reviews voter activity history",
        "Admin clears flag (releases payments) OR confirms fraud (rejects payments, bans voter)"
      ],
      "nodes": ["user-voter", "ui-voter-dashboard", "server-laravel-api", "service-fraud", "service-payment", "user-admin", "ui-admin-dashboard", "database-mysql"]
    },
    {
      "id": "flow-6",
      "name": "Payout Processing (Batch)",
      "description": "Weekly batch payout processing to voters via Stripe",
      "steps": [
        "Admin clicks Process Payouts (weekly/threshold-based)",
        "Send POST /api/admin/payouts/process",
        "Payment Processing Service queries voters with pending_earnings > $10",
        "For each eligible voter: create Stripe payout, move to total_earned, update last_payout_date",
        "Batch process completes",
        "Return summary: total voters paid, total amount, failures"
      ],
      "nodes": ["user-admin", "ui-admin-dashboard", "server-laravel-api", "service-payment", "database-mysql", "external-stripe"]
    },
    {
      "id": "flow-7",
      "name": "Wix App Installation",
      "description": "OAuth flow when app is installed on Wix site",
      "steps": [
        "User installs Dial4Dough app on Wix site",
        "Wix sends webhook POST /api/wix/webhooks with event app.installed",
        "Webhook Handler Service validates signature",
        "Auth Service creates record in wix_sites table",
        "Send OAuth redirect to user for permissions",
        "User grants permissions",
        "Wix redirects to /wix/oauth/callback?code=xxx",
        "Auth Service exchanges code for access token",
        "Store access_token and refresh_token in wix_sites",
        "App now fully installed and authenticated"
      ],
      "nodes": ["external-wix", "server-laravel-api", "service-webhook", "service-auth", "database-mysql"]
    }
  ],
