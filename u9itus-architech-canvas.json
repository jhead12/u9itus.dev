{
    "name": "U9itus - Political Loyalty Ads Platform",
    "description": "Complete system architecture showing $1.00/view revenue model with 25-50% profit margins. Deployed at https://u9itus-production.up.railway.app",
    "components": [
        {
            "id": "user-politician",
            "type": "user",
            "name": "Politician User",
            "position": {
                "x": 100,
                "y": 100
            },
            "properties": {
                "description": "Political candidate/office holder who creates campaigns",
                "actions": [
                    "Register",
                    "Create Campaign",
                    "Add Payment Method",
                    "Monitor Campaign"
                ]
            }
        },
        {
            "id": "user-voter",
            "type": "user",
            "name": "Voter User",
            "position": {
                "x": 100,
                "y": 300
            },
            "properties": {
                "description": "Registered voter who watches political ads and earns money",
                "actions": [
                    "Register",
                    "Watch Video",
                    "Generate Referral Code",
                    "Request Payout"
                ]
            }
        },
        {
            "id": "user-admin",
            "type": "user",
            "name": "Admin User",
            "position": {
                "x": 100,
                "y": 500
            },
            "properties": {
                "description": "Platform administrator",
                "actions": [
                    "Approve/Reject Campaigns",
                    "Review Fraud",
                    "Process Payouts"
                ]
            }
        },
        {
            "id": "ui-politician-dashboard",
            "type": "frontend",
            "name": "Wix Dashboard (Politician)",
            "position": {
                "x": 400,
                "y": 100
            },
            "properties": {
                "description": "Politician campaign management interface",
                "technology": "Wix Dashboard Extension (React)",
                "endpoints": [
                    "POST /api/politicians",
                    "POST /api/campaigns",
                    "GET /api/campaigns/{id}",
                    "POST /api/campaigns/{id}/payment"
                ]
            }
        },
        {
            "id": "ui-voter-dashboard",
            "type": "frontend",
            "name": "Wix Dashboard (Voter)",
            "position": {
                "x": 400,
                "y": 300
            },
            "properties": {
                "description": "Voter video viewing and earnings interface",
                "technology": "Wix Dashboard Extension (React)",
                "endpoints": [
                    "POST /api/voters",
                    "GET /api/voters/{id}/campaigns/available",
                    "POST /api/view-sessions",
                    "GET /api/voters/{id}/earnings"
                ]
            }
        },
        {
            "id": "ui-admin-dashboard",
            "type": "frontend",
            "name": "Wix Dashboard (Admin)",
            "position": {
                "x": 400,
                "y": 500
            },
            "properties": {
                "description": "Administrative control panel",
                "technology": "Wix Dashboard Extension (React)",
                "endpoints": [
                    "GET /api/admin/campaigns/pending",
                    "POST /api/admin/campaigns/{id}/approve",
                    "POST /api/admin/campaigns/{id}/reject",
                    "GET /api/admin/fraud-reviews",
                    "POST /api/admin/payouts/process"
                ]
            }
        },
        {
            "id": "ui-welcome",
            "type": "frontend",
            "name": "Laravel Welcome Page",
            "position": {
                "x": 400,
                "y": 700
            },
            "properties": {
                "description": "Public landing page showing revenue model",
                "technology": "Laravel Blade Template",
                "url": "https://u9itus-production.up.railway.app",
                "shows": "Revenue model, profit margins (25-50%), platform economics"
            }
        },
        {
            "id": "server-laravel-api",
            "type": "server",
            "name": "Laravel API Server",
            "position": {
                "x": 700,
                "y": 300
            },
            "properties": {
                "description": "Main backend API orchestrating all business logic",
                "technology": "Laravel 12 / PHP 8.2",
                "port": 8080,
                "url": "https://u9itus-production.up.railway.app",
                "hosting": "Railway.app",
                "responsibilities": [
                    "RESTful API endpoints",
                    "Business logic orchestration",
                    "Authentication & authorization",
                    "Request validation",
                    "Response formatting"
                ]
            }
        },
        {
            "id": "service-auth",
            "type": "auth_service",
            "name": "Auth Service (Wix OAuth)",
            "position": {
                "x": 1000,
                "y": 100
            },
            "properties": {
                "description": "Handles Wix authentication and site installations",
                "technology": "Laravel + Wix SDK",
                "responsibilities": [
                    "Wix OAuth flow (/wix/oauth/callback)",
                    "Instance token validation",
                    "Site installation tracking",
                    "Member authentication"
                ],
                "externalDependency": "https://www.wixapis.com"
            }
        },
        {
            "id": "service-campaign",
            "type": "analytics",
            "name": "Campaign Management",
            "position": {
                "x": 1000,
                "y": 200
            },
            "properties": {
                "description": "Manages campaign lifecycle and status transitions",
                "technology": "Laravel Service Layer",
                "responsibilities": [
                    "Campaign creation and validation",
                    "Status transitions (draft → pending → active → completed)",
                    "Budget management",
                    "Ad assignment to campaigns"
                ],
                "statuses": [
                    "draft",
                    "pending_approval",
                    "active",
                    "paused",
                    "completed",
                    "rejected"
                ]
            }
        },
        {
            "id": "service-view-tracking",
            "type": "analytics",
            "name": "View Tracking Service",
            "position": {
                "x": 1000,
                "y": 300
            },
            "properties": {
                "description": "Tracks video watch time and validates completion",
                "technology": "Laravel Service Layer",
                "responsibilities": [
                    "Create view sessions",
                    "Update watch time progress",
                    "Mark sessions as completed",
                    "Trigger payment after completion"
                ],
                "completionThreshold": "90% of video duration"
            }
        },
        {
            "id": "service-payment",
            "type": "analytics",
            "name": "Payment Processing",
            "position": {
                "x": 1000,
                "y": 400
            },
            "properties": {
                "description": "Handles all payment operations via Stripe",
                "technology": "Laravel + Stripe API",
                "responsibilities": [
                    "Charge politicians $1.00 per view",
                    "Payout voters $0.25 per completed view",
                    "Process referral commissions (10% = $0.025)",
                    "Batch payout processing",
                    "Handle payment failures and refunds"
                ],
                "processingFee": "$0.02 per transaction"
            }
        },
        {
            "id": "service-fraud",
            "type": "analytics",
            "name": "Fraud Detection",
            "position": {
                "x": 1000,
                "y": 500
            },
            "properties": {
                "description": "Detects and prevents fraudulent viewing activity",
                "technology": "Laravel Service Layer",
                "responsibilities": [
                    "IP address tracking",
                    "Multiple views from same user detection",
                    "Rapid replay detection",
                    "Watch pattern analysis",
                    "Flag suspicious sessions for admin review"
                ],
                "rules": [
                    "Max 1 view per campaign per voter",
                    "Minimum watch time validation",
                    "Velocity checks"
                ]
            }
        },
        {
            "id": "service-referral",
            "type": "analytics",
            "name": "Referral System",
            "position": {
                "x": 1000,
                "y": 600
            },
            "properties": {
                "description": "Manages referral codes and 10% commission payouts",
                "technology": "Laravel Service Layer",
                "responsibilities": [
                    "Generate unique referral codes",
                    "Track referral relationships",
                    "Calculate 10% commission ($0.025 per view)",
                    "Payout referrer when referee completes view"
                ],
                "commission": "10% of viewer payout ($0.025)"
            }
        },
        {
            "id": "service-notification",
            "type": "analytics",
            "name": "Notification Service (Wix)",
            "position": {
                "x": 1000,
                "y": 650
            },
            "properties": {
                "description": "Secure ad delivery via Wix email/push/SMS APIs with token generation",
                "technology": "Laravel + Wix APIs",
                "responsibilities": [
                    "Generate one-time secure tokens (SHA-256)",
                    "Send notifications via Wix Triggered Emails API",
                    "Send push notifications via Wix Notifications API",
                    "Send SMS via Wix Marketing API",
                    "Rate limiting (10 ads per 24 hours)",
                    "Token expiration management (24 hours)",
                    "Batch notification distribution"
                ],
                "wixAPIs": [
                    "/v1/triggered-emails/send",
                    "/v1/notifications/send",
                    "/v1/marketing/sms/send",
                    "/v1/automations/create"
                ],
                "security": [
                    "One-time use tokens",
                    "24-hour expiration",
                    "IP/device tracking",
                    "Prevents panel abuse"
                ]
            }
        },
        {
            "id": "service-webhook",
            "type": "analytics",
            "name": "Webhook Handler",
            "position": {
                "x": 1000,
                "y": 700
            },
            "properties": {
                "description": "Processes incoming Wix platform webhooks",
                "technology": "Laravel Event Handlers",
                "responsibilities": [
                    "App installation/uninstallation events",
                    "Member login/logout events",
                    "Update local state based on Wix events"
                ],
                "endpoint": "/wix/webhooks"
            }
        },
        {
            "id": "database-mysql",
            "type": "database",
            "name": "MySQL Database",
            "position": {
                "x": 1300,
                "y": 400
            },
            "properties": {
                "description": "Primary data store for all application data",
                "technology": "MySQL 9.4.0",
                "hosting": "Railway (shinkansen.proxy.rlwy.net:39648)",
                "tables": [
                    "politicians",
                    "voters",
                    "campaigns",
                    "ads",
                    "view_sessions",
                    "payments",
                    "referrals",
                    "wix_instances",
                    "fraud_reviews",
                    "ad_view_tokens (one-time secure tokens for notifications)"
                ]
            }
        },
        {
            "id": "external-stripe",
            "type": "analytics",
            "name": "Stripe Payment Gateway",
            "position": {
                "x": 1300,
                "y": 100
            },
            "properties": {
                "description": "Processes all payments and payouts (External Service)",
                "api": "https://api.stripe.com",
                "operations": [
                    "Charge politicians $1.00 per view",
                    "Payout voters $0.25 per view",
                    "Payout referrers $0.025 per referral"
                ],
                "fee": "$0.02 + 2.9% per transaction"
            }
        },
        {
            "id": "external-wix",
            "type": "analytics",
            "name": "Wix Platform",
            "position": {
                "x": 1300,
                "y": 600
            },
            "properties": {
                "description": "Hosts dashboards and provides OAuth (External Service)",
                "api": "https://www.wixapis.com",
                "services": [
                    "OAuth 2.0 authentication",
                    "Dashboard extension hosting",
                    "Member management API",
                    "Webhook delivery",
                    "Triggered Emails API (ad notifications)",
                    "Push Notifications API (instant alerts)",
                    "Marketing/SMS API (text notifications)",
                    "Automations API (workflow triggers)"
                ]
            }
        },
        {
            "id": "external-video",
            "type": "analytics",
            "name": "Video Hosting",
            "position": {
                "x": 1300,
                "y": 800
            },
            "properties": {
                "description": "Hosts political ad videos (External Service)",
                "options": [
                    "Vimeo",
                    "YouTube",
                    "Cloudflare Stream",
                    "AWS S3 + CloudFront"
                ],
                "requirements": [
                    "Embed support",
                    "Progress tracking API",
                    "CDN delivery for performance"
                ]
            }
        }
