* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Mark the archived Laravel 4 codebase as linguist-vendored so GitHub
# excludes it from language stats AND security scanning (Dependabot
# already scoped via .github/dependabot.yml). These files never ship.
legacy/** linguist-vendored=true
legacy/** linguist-generated=true
